{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PC Cleaner",
  "version": "0.3.4",
  "identifier": "com.pccleaner.desktop",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "PC Cleaner",
        "width": 1120,
        "height": 760,
        "minWidth": 920,
        "minHeight": 640,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico"]
  }
}
